generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  industry         String?
  productsServices String?
  size             String?
  location         String?
  website          String?
  currentHrProcess String?
  aiSuggestions    String?
  setupComplete    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users       User[]
  departments Department[]
  jobs        Job[]
  employees   Employee[]
  settings    CompanySettings?
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id])
  country         String   @default("Uganda")
  currency        String   @default("UGX")
  currencySymbol  String   @default("UGX")
  timezone        String   @default("Africa/Kampala")
  nssfEnabled     Boolean  @default(true)
  payeEnabled     Boolean  @default(true)
  probationMonths Int      @default(3)
  annualLeaveDays Int      @default(21)
  sickLeaveDays   Int      @default(10)
  maternityLeave  Int      @default(60)
  paternityLeave  Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
  employees Employee[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("HR_OFFICER")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model Job {
  id                 String    @id @default(cuid())
  title              String
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  location           String?
  employmentType     String    @default("FULL_TIME")
  description        String?
  responsibilities   String?
  requiredSkills     String[]  @default([])
  preferredSkills    String[]  @default([])
  experienceLevel    String?
  education          String?
  salaryMin          Float?
  salaryMax          Float?
  currency           String    @default("UGX")
  deadline           DateTime?
  status             String    @default("DRAFT")
  screeningKeywords  String[]  @default([])
  scoringCriteria    Json?
  interviewQuestions String[]  @default([])
  aiApproved         Boolean   @default(false)
  publicSlug         String?   @unique
  embedCode          String?
  hiringManagerId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidates Candidate[]
}

model Candidate {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  location        String?
  linkedIn        String?
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id])
  resumeUrl       String?
  resumeText      String?
  resumeParsed    Json?
  status          String    @default("RECEIVED")
  screeningScore  Float?
  screeningNotes  String?
  screeningData   Json?
  applicationDate DateTime  @default(now())
  source          String?
  notes           String?
  // Parsed resume fields
  parsedName      String?
  parsedEmail     String?
  parsedPhone     String?
  parsedLocation  String?
  parsedEducation String?
  parsedExperience String?
  parsedSkills    String[]  @default([])
  parsedJobTitles String[]  @default([])
  parsedEmployers String[]  @default([])
  parsedYearsExp  Float?
  certifications  String[]  @default([])
  // Duplicate detection
  isDuplicate     Boolean   @default(false)
  duplicateOf     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  interviews     Interview[]
  communications CandidateComm[]
  statusHistory  CandidateStatusHistory[]
  offer          Offer?
  employee       Employee?
  documents      FileUpload[]
}

model CandidateStatusHistory {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  fromStatus  String?
  toStatus    String
  reason      String?
  changedBy   String?
  createdAt   DateTime  @default(now())
}

model Interview {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  scheduledAt  DateTime
  type         String    @default("in-person")
  interviewers String[]  @default([])
  location     String?
  meetingLink  String?
  notes        String?
  feedback     String?
  score        Float?
  status       String    @default("scheduled")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CandidateComm {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  subject     String
  body        String
  type        String    @default("email")
  template    String?
  // Approval workflow
  status      String    @default("draft") // draft | pending_approval | approved | sent | failed
  sentBy      String?
  sentAt      DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  failReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Offer {
  id               String    @id @default(cuid())
  candidateId      String    @unique
  candidate        Candidate @relation(fields: [candidateId], references: [id])
  role             String
  salary           Float
  currency         String    @default("UGX")
  startDate        DateTime
  probationMonths  Int       @default(3)
  supervisor       String?
  workLocation     String?
  benefits         String?
  terms            String?
  letterUrl        String?
  signedUrl        String?
  status           String    @default("draft") // draft | pending_hr_approval | approved | sent | signed | declined | expired
  sentAt           DateTime?
  signedAt         DateTime?
  expiresAt        DateTime?
  // Digital signing
  signatureToken   String?   @unique
  signedByName     String?
  signatureData    String?
  signatureIp      String?
  signatureDevice  String?
  // HR approval
  hrApprovedBy     String?
  hrApprovedAt     DateTime?
  hrApprovalStatus String    @default("pending") // pending | approved | rejected
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Employee {
  id               String    @id @default(cuid())
  candidateId      String?   @unique
  candidate        Candidate? @relation(fields: [candidateId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  employeeOnboarding EmployeeOnboarding?
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  employeeNumber   String?
  firstName        String
  lastName         String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  nationality      String?
  address          String?
  jobTitle         String
  employmentType   String    @default("FULL_TIME")
  startDate        DateTime
  endDate          DateTime?
  supervisorId     String?
  salary           Float?
  currency         String    @default("UGX")
  paymentFrequency String?
  allowances       Json?
  benefits         Json?
  deductions       Json?
  // Uganda compliance fields
  nssfNumber       String?
  nssfRate         Float?    @default(10)
  tinNumber        String?
  payeRate         Float?
  bankName         String?
  bankAccount      String?
  bankBranch       String?
  mobileMoneyNumber String?
  mobileMoneyProvider String?
  // Leave
  annualLeave      Float     @default(21)
  sickLeave        Float     @default(10)
  maternityLeave   Float?
  paternityLeave   Float?
  // Contract / compliance
  contractType     String?   // permanent | fixed_term | casual | probationary
  contractEndDate  DateTime?
  probationMonths  Int?      @default(3)
  probationEndDate DateTime?
  workPermitNumber String?
  workPermitExpiry DateTime?
  // Status
  isActive         Boolean   @default(true)
  terminationReason String?
  terminationDate  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  onboarding          Onboarding?
  documents           EmployeeDocument[]
  performanceReviews  PerformanceReview[]
  caseFiles           CaseFile[]
  leaveRecords        LeaveRecord[]
  salaryHistory       SalaryHistory[]
  compensationChanges CompensationChange[]
  complianceRecords   ComplianceRecord[]
}

model Onboarding {
  id                       String    @id @default(cuid())
  employeeId               String    @unique
  employee                 Employee  @relation(fields: [employeeId], references: [id])
  tasks                    Json?
  completedTasks           String[]  @default([])
  personalInfoComplete     Boolean   @default(false)
  emergencyContactComplete Boolean   @default(false)
  bankDetailsComplete      Boolean   @default(false)
  contractSigned           Boolean   @default(false)
  policiesAcknowledged     Boolean   @default(false)
  orientationComplete      Boolean   @default(false)
  status                   String    @default("pending")
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String
  type       String
  url        String
  storageKey String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model FileUpload {
  id           String    @id @default(cuid())
  companyId    String?
  entityType   String    // candidate | employee | offer | company
  entityId     String
  name         String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  storageUrl   String?
  bucket       String?
  provider     String    @default("local") // local | s3 | supabase | cloudinary
  uploadedBy   String?
  isPrivate    Boolean   @default(true)
  createdAt    DateTime  @default(now())

  candidate Candidate? @relation(fields: [entityId], references: [id], map: "FileUpload_candidateId_fkey")
}

model PerformanceReview {
  id                   String    @id @default(cuid())
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id])
  cycle                String
  period               String
  status               String    @default("PENDING")
  selfEvaluation       Json?
  supervisorEvaluation Json?
  goals                Json?
  goalsScore           Float?
  skillsScore          Float?
  overallScore         Float?
  comments             String?
  aiSummary            String?
  recommendations      String?
  promotionRecommended Boolean   @default(false)
  trainingRecommended  String?
  improvementPlan      String?
  dueDate              DateTime
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model CaseFile {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  caseType    String
  description String
  dateOpened  DateTime  @default(now())
  status      String    @default("OPEN")
  notes       String?
  resolution  String?
  documents   String[]  @default([])
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LeaveRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("pending") // pending | approved | rejected | cancelled
  reason     String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  salary        Float
  currency      String   @default("UGX")
  effectiveDate DateTime
  reason        String?
  approvedBy    String?
  createdAt     DateTime @default(now())
}

model CompensationChange {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  changeType    String    // salary | allowance | benefit | deduction
  description   String?
  fromAmount    Float?
  toAmount      Float
  currency      String    @default("UGX")
  effectiveDate DateTime
  reason        String
  requestedBy   String?
  approvedBy    String?
  approvedAt    DateTime?
  status        String    @default("pending") // pending | approved | rejected | applied
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ComplianceRecord {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  type        String    // nssf | paye | leave_policy | contract | work_permit | disciplinary | probation
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("pending") // pending | compliant | overdue | waived
  data        Json?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ─── Onboarding Management System ────────────────────────────────────────────

model OnboardingMaterial {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  description  String?
  category     String   @default("general")
  // welcome | contract | policy | it | training | payroll | compliance | role_specific | orientation
  fileUrl      String?
  fileType     String?
  storageKey   String?
  version      String   @default("1.0")
  status       String   @default("active")  // active | archived | draft
  appliesTo    String   @default("all")     // all | department | role | path
  appliesValue String?
  uploadedBy   String?
  isRequired   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stepMaterials    OnboardingStepMaterial[]
  acknowledgements OnboardingAcknowledgement[]
}

model OnboardingPath {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  department     String?
  role           String?
  employmentType String?
  durationDays   Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps               OnboardingStep[]
  employeeOnboardings EmployeeOnboarding[]
}

model OnboardingStep {
  id            String         @id @default(cuid())
  pathId        String
  path          OnboardingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  stepOrder     Int
  ownerRole     String         @default("employee") // employee | hr | supervisor | it | finance
  dueOffsetDays Int            @default(1)
  isRequired    Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  materials OnboardingStepMaterial[]
  tasks     EmployeeOnboardingTask[]
}

model OnboardingStepMaterial {
  id         String             @id @default(cuid())
  stepId     String
  step       OnboardingStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  materialId String
  material   OnboardingMaterial @relation(fields: [materialId], references: [id])

  @@unique([stepId, materialId])
}

model EmployeeOnboarding {
  id               String          @id @default(cuid())
  employeeId       String          @unique
  employee         Employee        @relation(fields: [employeeId], references: [id])
  pathId           String?
  path             OnboardingPath? @relation(fields: [pathId], references: [id])
  status           String          @default("in_progress") // in_progress | completed | paused
  progressPercent  Float           @default(0)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  assignedBy       String?
  assignmentReason String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tasks        EmployeeOnboardingTask[]
  activityLogs OnboardingActivityLog[]
}

model EmployeeOnboardingTask {
  id                   String             @id @default(cuid())
  employeeOnboardingId String
  employeeOnboarding   EmployeeOnboarding @relation(fields: [employeeOnboardingId], references: [id], onDelete: Cascade)
  stepId               String?
  step                 OnboardingStep?    @relation(fields: [stepId], references: [id])
  title                String
  description          String?
  ownerRole            String             @default("employee") // employee | hr | supervisor | it | finance
  status               String             @default("pending")  // pending | completed | skipped
  dueDate              DateTime?
  completedAt          DateTime?
  completedBy          String?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model OnboardingAcknowledgement {
  id             String             @id @default(cuid())
  employeeId     String
  materialId     String
  material       OnboardingMaterial @relation(fields: [materialId], references: [id])
  acknowledgedAt DateTime           @default(now())
  signatureText  String?
  ipAddress      String?

  @@unique([employeeId, materialId])
}

model OnboardingActivityLog {
  id                   String             @id @default(cuid())
  employeeOnboardingId String
  employeeOnboarding   EmployeeOnboarding @relation(fields: [employeeOnboardingId], references: [id])
  actorId              String?
  action               String
  details              String?
  createdAt            DateTime           @default(now())
}

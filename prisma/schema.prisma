  cscInductionDate      DateTime?
  cscInductionCompleted Boolean     @default(false)
  annualLeaveBalance    Float       @default(21)
  sickLeaveBalance      Float       @default(30)
  maternityLeaveBalance Float       @default(60)
  paternityLeaveBalance Float       @default(4)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  deploymentHistory DeploymentRecord[]
  salaryHistory     GovernmentSalaryHistory[]
  leaveRequests     LeaveRequest[]
  disciplineCases   DisciplineCase[]
  grievanceCases    GrievanceCase[]
  probationRecord   ProbationRecord?
  payrollCerts      PayrollCertification[]
  hcmSyncRecords    HcmSyncRecord[]
  documents         EmployeeDocument[]
}

model DeploymentRecord {
  id          String                    @id @default(cuid())
  employeeId  String
  employee    EmployeeGovernmentProfile @relation(fields: [employeeId], references: [id])
  type        String                    // transfer | promotion | acting | secondment | demotion
  fromPost    String?
  toPost      String
  fromDept    String?
  toDept      String?
  fromGrade   String?
  toGrade     String?
  effectiveDate DateTime
  endDate     DateTime?
  reason      String?
  authorizedBy String?
  documentUrl String?
  createdAt   DateTime                  @default(now())
}

model GovernmentSalaryHistory {
  id            String                    @id @default(cuid())
  employeeId    String
  employee      EmployeeGovernmentProfile @relation(fields: [employeeId], references: [id])
  salaryScale   String
  grossSalary   Float
  currency      String                    @default("UGX")
  effectiveDate DateTime
  financialYear String
  reason        String?
  approvedBy    String?
  createdAt     DateTime                  @default(now())
}

model HcmSyncRecord {
  id           String                    @id @default(cuid())
  employeeId   String
  employee     EmployeeGovernmentProfile @relation(fields: [employeeId], references: [id])
  syncType     String                    // create | update | terminate
  payload      Json
  response     Json?
  status       String                    @default("pending") // pending | success | failed
  errorMessage String?
  syncedAt     DateTime?
  createdAt    DateTime                  @default(now())
}

// ─── DSC-HRMS: Probation ──────────────────────────────────────────────────────

model ProbationRecord {
  id               String                    @id @default(cuid())
  employeeId       String                    @unique
  employee         EmployeeGovernmentProfile @relation(fields: [employeeId], references: [id])
  probationMonths  Int                       @default(12)
  startDate        DateTime
  expectedEndDate  DateTime
  actualEndDate    DateTime?
  status           String                    @default("on_probation") // on_probation | extended | confirmed | terminated
  extensionMonths  Int?
  extensionReason  String?
  dscDecision      String?
  dscDecisionDate  DateTime?
  minuteRef        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  reviews      ProbationReview[]

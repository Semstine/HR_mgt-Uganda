}

model InterviewPanelMember {
  id         String         @id @default(cuid())
  panelId    String
  panel      InterviewPanel @relation(fields: [panelId], references: [id])
  memberId   String
  memberRole String         // dsc_chairperson | secretary_dsc | hod | dsc_member | coopted | esc_rep | hsc_rep
  hasScored  Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model InterviewSchedule {
  id               String              @id @default(cuid())
  panelId          String
  panel            InterviewPanel      @relation(fields: [panelId], references: [id])
  applicationId    String
  application      PSCForm3Application @relation(fields: [applicationId], references: [id])
  scheduledDate    DateTime
  scheduledTime    String
  venue            String
  duration         Int                 @default(30)
  candidateStatus  String              @default("invited") // invited | confirmed | declined | reschedule_requested | attended | absent
  invitedAt        DateTime?
  confirmedAt      DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  scores InterviewScore[]
}

model InterviewScore {
  id             String              @id @default(cuid())
  panelId        String
  panel          InterviewPanel      @relation(fields: [panelId], references: [id])
  applicationId  String
  application    PSCForm3Application @relation(fields: [applicationId], references: [id])
  scheduleId     String?
  schedule       InterviewSchedule?  @relation(fields: [scheduleId], references: [id])
  scorerId       String
  scores         Json
  totalScore     Float
  recommendation String             // appointed | reserve | rejected | deferred
  notes          String?
  isSubmitted    Boolean             @default(false)
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@unique([panelId, applicationId, scorerId])
}

model WrittenTest {
  id          String         @id @default(cuid())
  panelId     String
  panel       InterviewPanel @relation(fields: [panelId], references: [id])
  testName    String
  testDate    DateTime
  duration    Int
  maxScore    Float          @default(100)
  passMark    Float          @default(50)
  cadre       String?
  testFileUrl String?
  status      String         @default("scheduled") // scheduled | administered | scored | cancelled

  updatedAt     DateTime            @updatedAt

  @@unique([panelId, applicationId, scorerId])
}

model ShortlistDecision {
  id             String              @id @default(cuid())
  panelId        String
  panel          ShortlistingPanel   @relation(fields: [panelId], references: [id])
  applicationId  String              @unique
  application    PSCForm3Application @relation(fields: [applicationId], references: [id])
  finalDecision  String              // shortlisted | rejected | reserve | conditional
  rejectionReason String?
  decisionBy     String?
  approvedBy     String?
  approvedAt     DateTime?
  notifiedAt     DateTime?
  createdAt      DateTime            @default(now())
}

// ─── DSC-HRMS: Interviews ─────────────────────────────────────────────────────

model InterviewPanel {
  id                 String           @id @default(cuid())
  recruitmentCycleId String           @unique
  recruitmentCycle   RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id])
  createdBy          String
  status             String           @default("scheduling") // scheduling | active | completed | cancelled

}

model ShortlistingScore {
  id            String              @id @default(cuid())
  panelId       String
  panel         ShortlistingPanel   @relation(fields: [panelId], references: [id])
  applicationId String
  application   PSCForm3Application @relation(fields: [applicationId], references: [id])

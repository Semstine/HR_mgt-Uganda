// ─── DSC-HRMS: Discipline & Grievance ────────────────────────────────────────

model DisciplineCase {
  id               String                    @id @default(cuid())
  employeeId       String
  employee         EmployeeGovernmentProfile @relation(fields: [employeeId], references: [id])
  districtId       String
  caseRef          String                    @unique
  allegation       String
  showCauseIssued  Boolean                   @default(false)
  showCauseDate    DateTime?
  responseReceived Boolean                   @default(false)
  hearingDate      DateTime?
  panelMembers     String[]                  @default([])
  findings         String?
  dscDecision      String?                   // warning | demotion | dismissal | no_case | suspended_sentence
  decisionDate     DateTime?
  minuteRef        String?
  appealStatus     String                    @default("none") // none | appealed | upheld | dismissed
  documentUrls     String[]                  @default([])
  status           String                    @default("investigation") // investigation | show_cause | hearing | decided | appeal | closed
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model GrievanceCase {
  id             String                    @id @default(cuid())
  employeeId     String

}

model ProbationReview {
  id              String          @id @default(cuid())
  probationId     String
  probation       ProbationRecord @relation(fields: [probationId], references: [id])
  reviewMonth     Int
  reviewType      String          // progress | final
  submittedBy     String?
  submittedAt     DateTime?
  performance     String?         // excellent | good | satisfactory | unsatisfactory
  narrative       String?
  recommendation  String?         // confirm | extend | terminate
  documentUrl     String?
  status          String          @default("pending") // pending | submitted | reviewed
  createdAt       DateTime        @default(now())
}

model ConfirmationDecision {
  id           String          @id @default(cuid())
  probationId  String          @unique
  probation    ProbationRecord @relation(fields: [probationId], references: [id])
  decision     String          // confirmed | extended | terminated
  decisionDate DateTime
  effectiveDate DateTime?
  minuteRef    String?
  letterUrl    String?
  decidedBy    String?
  notes        String?
  createdAt    DateTime        @default(now())
}


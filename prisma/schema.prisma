// ─── DSC-HRMS: Shortlisting ───────────────────────────────────────────────────

model ShortlistingPanel {
  id                String           @id @default(cuid())
  recruitmentCycleId String          @unique
  recruitmentCycle  RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id])
  createdBy         String
  lockedBy          String?
  lockedAt          DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  minuteRef         String?
  status            String           @default("open") // open | scoring | locked | approved | published
  scoringCriteria   Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  panelMembers ShortlistPanelMember[]
  scores       ShortlistingScore[]
  decisions    ShortlistDecision[]
}

model ShortlistPanelMember {
  id           String            @id @default(cuid())
  panelId      String
  panel        ShortlistingPanel @relation(fields: [panelId], references: [id])
  memberId     String
  memberRole   String            // dsc_chairperson | dsc_member | secretary
  hasSubmitted Boolean           @default(false)

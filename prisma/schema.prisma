// ─── DSC-HRMS: Employee Government Profile ────────────────────────────────────

model EmployeeGovernmentProfile {
  id                    String      @id @default(cuid())
  districtId            String
  district              District    @relation(fields: [districtId], references: [id])
  salaryScaleId         String?
  salaryScale           SalaryScale? @relation(fields: [salaryScaleId], references: [id])
  employeeNumber        String      @unique
  firstName             String
  lastName              String
  otherNames            String?
  nin                   String      @unique
  tinNumber             String?
  nssfNumber            String?
  dateOfBirth           DateTime
  gender                String
  pwdStatus             Boolean     @default(false)
  nationality           String      @default("Ugandan")
  phone                 String?
  email                 String?
  postTitle             String
  grade                 String
  department            String
  dutyStation           String
  reportingOfficer      String?
  appointmentDate       DateTime
  confirmationDate      DateTime?
  employmentStatus      String      @default("active") // active | on_leave | suspended | retired | deceased | resigned | dismissed
  contractType          String      @default("permanent") // permanent | contract | acting
  bankName              String?
  bankAccount           String?
  bankBranch            String?
  hcmEmployeeId         String?
  hcmSyncStatus         String      @default("pending") // pending | synced | failed
  hcmSyncedAt           DateTime?

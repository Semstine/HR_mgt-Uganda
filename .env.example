# PostgreSQL connection string
# Local: postgresql://USER:PASSWORD@localhost:5432/talentbridge
# Hosted (Supabase, Neon, Railway, etc.): paste the connection string directly
DATABASE_URL="postgresql://postgres:password@localhost:5432/talentbridge"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Email (optional — use Ethereal for testing: https://ethereal.email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TalentBridge Africa"

# Storage provider: local | s3 | supabase | cloudinary (default: local)
STORAGE_PROVIDER="local"

# AWS S3 (only required when STORAGE_PROVIDER=s3)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
